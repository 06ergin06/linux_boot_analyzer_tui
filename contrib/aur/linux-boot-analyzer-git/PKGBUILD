# Maintainer: İbrahim Hakkı Ergin <ibrahimh.ergin@gmail.com>
pkgname=linux-boot-analyzer-git
pkgver=r1.0.2
pkgrel=1
pkgdesc="A terminal UI that analyses boot time and manages systemd services"
arch=('x86_64' 'aarch64')
url="https://github.com/06ergin06/linux_boot_analyzer_tui"
license=('GPL-3.0-only')
depends=('sudo')
makedepends=('cargo' 'gcc' 'git')
provides=('linux-boot-analyzer')
conflicts=('linux-boot-analyzer' 'linux-boot-analyzer-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    cargo build --release --locked
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/linux-boot-analyzer "$pkgdir/usr/bin/linux-boot-analyzer"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
